# MySQL connection string used by Prisma.
DATABASE_URL="mysql://nilgiri_app:change-me@localhost:3306/niligiribytes"

# Used only by the one-time seed/import script.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-before-seeding"

# Phase 2 auth secret (kept here so the schema/migration is ready).
AUTH_SECRET="replace-with-a-long-random-string"

# Canonical site URL (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://www.niligibytes.com"
