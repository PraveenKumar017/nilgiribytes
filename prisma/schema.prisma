generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @unique @db.VarChar(80)
  name      String    @db.VarChar(120)
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          Int           @id @default(autoincrement())
  sku         String?       @unique @db.VarChar(40)
  slug        String        @unique @db.VarChar(160)
  name        String        @db.VarChar(160)
  description String        @db.Text
  categoryId  Int
  category    Category      @relation(fields: [categoryId], references: [id])
  posterUrl   String?       @db.VarChar(500)
  imageUrl    String?       @db.VarChar(500)
  imageAlt    String?       @db.VarChar(240)
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  sizes       ProductSize[]
  comboItems  ComboItem[]
  orderItems  OrderItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId, isActive])
}

model ProductSize {
  id         Int     @id @default(autoincrement())
  productId  Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String  @db.VarChar(40)
  grams      Int?
  pricePaise Int
  imageUrl   String? @db.VarChar(500)
  sortOrder  Int     @default(0)

  @@unique([productId, label])
}

model Combo {
  id          Int          @id @default(autoincrement())
  sku         String?      @unique @db.VarChar(40)
  slug        String       @unique @db.VarChar(160)
  name        String       @db.VarChar(160)
  description String       @db.Text
  imageUrl    String?      @db.VarChar(500)
  imageAlt    String?      @db.VarChar(240)
  weightLabel String?      @db.VarChar(60)
  pricePaise  Int
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  items       ComboItem[]
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ComboItem {
  id            Int      @id @default(autoincrement())
  comboId       Int
  combo         Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId     Int?
  product       Product? @relation(fields: [productId], references: [id])
  nameSnapshot  String   @db.VarChar(160)
  quantityLabel String   @db.VarChar(60)
  sortOrder     Int      @default(0)
}

model BlogPost {
  id             Int        @id @default(autoincrement())
  slug           String     @unique @db.VarChar(200)
  title          String     @db.VarChar(240)
  category       String     @db.VarChar(80)
  author         String?    @db.VarChar(120)
  date           DateTime
  coverImage     String?    @db.VarChar(500)
  imageAlt       String?    @db.VarChar(240)
  excerpt        String?    @db.Text
  status         PostStatus @default(DRAFT)
  content        Json
  readingTimeMin Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, date])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(80)
  passwordHash String    @db.VarChar(255)
  role         Role      @default(ADMIN)
  sessions     Session[]
  createdAt    DateTime  @default(now())
}

enum Role {
  ADMIN
  EDITOR
}

model Session {
  id        String    @id @db.VarChar(64)
  userId    Int
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Order {
  id            Int          @id @default(autoincrement())
  orderNumber   String       @unique @db.VarChar(40)
  customerName  String       @db.VarChar(160)
  phone         String       @db.VarChar(30)
  email         String?      @db.VarChar(160)
  address       String?      @db.Text
  notes         String?      @db.Text
  subtotalPaise Int
  totalPaise    Int
  channel       OrderChannel @default(WHATSAPP)
  status        OrderStatus  @default(NEW)
  items         OrderItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
}

enum OrderChannel {
  WHATSAPP
  ONLINE
}

enum OrderStatus {
  NEW
  CONFIRMED
  PACKED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id             Int     @id @default(autoincrement())
  orderId        Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      Int?
  product        Product? @relation(fields: [productId], references: [id])
  comboId        Int?
  combo          Combo?  @relation(fields: [comboId], references: [id])
  nameSnapshot   String  @db.VarChar(200)
  sizeLabel      String? @db.VarChar(60)
  unitPricePaise Int
  quantity       Int
  lineTotalPaise Int
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(200)
  createdAt DateTime @default(now())
}

model Settings {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(80)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
